{
  "name": "conti-visitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "访客管理移动端 - H5 + 微信小程序（uni-app Vue3 + Vite + TS）",
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:custom": "uni -p",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:custom": "uni build -p",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.{vue,css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{vue,css,scss}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-h5": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "@wot-ui/router": "1.2.0",
    "@wot-ui/ui": "2.4.0",
    "pinia": "2.1.7",
    "vue": "~3.4.38",
    "vue-i18n": "^11.4.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@eslint/js": "^10.0.1",
    "@vue/tsconfig": "^0.9.1",
    "@wot-ui/unocss-preset": "1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "miniprogram-api-typings": "^5.2.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.12.0",
    "unocss-preset-weapp": "^66.0.2",
    "unplugin-auto-import": "^19.3.0",
    "vite": "5.4.21",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,vue}": [
      "stylelint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
